# Example nginx reverse proxy config for cms-admin.
# Copy to /etc/nginx/sites-available/cms-admin, adjust server_name,
# then symlink into sites-enabled and reload nginx. See DEPLOYMENT.md.

server {
    listen 80;
    listen [::]:80;
    server_name admin.example.com;

    # Certbot will add the 443 server block + redirect automatically
    # when you run: certbot --nginx -d admin.example.com

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Required for websockets (HMR is dev-only, but keep this for safety)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Next.js App Router streams responses (Suspense/loading.tsx) — do not buffer.
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
